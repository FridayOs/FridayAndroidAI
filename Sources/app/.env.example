# FRIDAY AI Android local cloud settings
# Copy to .env or local.properties wiring later. Do not commit real secrets.

FRIDAY_BACKEND_MODE=firebase

# Legacy/reference Node API mode only. Android phone on LAN must use server LAN IP, not localhost.
FRIDAY_API_BASE_URL=http://192.168.x.x:3101

# Firebase values come from Firebase Console / google-services.json.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# OAuth client IDs if needed by explicit Google sign-in flow.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
