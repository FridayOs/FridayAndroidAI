<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- M1 Friday API: dev backend runs on http://localhost:3101. Production
         uses the system HTTPS base URL; this cleartext exception is scoped to
         10.0.2.2 (emulator host loopback) and localhost only and is not active
         for any other cleartext destination. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>