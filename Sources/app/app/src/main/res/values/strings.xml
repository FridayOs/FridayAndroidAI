    <!-- Onboarding Terms & Conditions (FRI-582 P4, design-spec §3, HTML TERMS array lines 1417-1430) -->
    <string name="onboarding_terms_topbar_title">Terms of use</string>
    <string name="onboarding_terms_title">Before we start</string>
    <string name="onboarding_terms_subtitle">Plain language. No dark patterns.</string>
    <string name="onboarding_terms_card1_title">Your data stays yours</string>
    <string name="onboarding_terms_card1_body">Chats, prompts, answers, transcripts, documents, memories, gateway settings, API keys, base URLs, and model choices stay on this phone by default.</string>
    <string name="onboarding_terms_card2_title">What sign-in is for</string>
    <string name="onboarding_terms_card2_body">Google sign-in lets FRIDAY identify your account, register your device, and apply entitlement or policy metadata. It does not upload your private assistant history.</string>
    <string name="onboarding_terms_card3_title">Your gateways, your calls</string>
    <string name="onboarding_terms_card3_body">When you add a provider like Gemini, OpenAI, Anthropic, OpenClaw, Hermes, or a custom endpoint, FRIDAY calls it directly from this phone. That provider\'s rules apply to those requests.</string>
    <string name="onboarding_terms_card4_title">Friday can be wrong</string>
    <string name="onboarding_terms_card4_body">Treat answers as assistance, not authority. Verify anything medical, legal, financial, or safety-critical.</string>
    <string name="onboarding_terms_card5_title">Local security matters</string>
    <string name="onboarding_terms_card5_body">If you enable app lock and lose the password, encrypted local data may not be recoverable.</string>
    <string name="onboarding_terms_card6_title">Agreement</string>
    <string name="onboarding_terms_card6_body">By continuing, you agree to use FRIDAY AI responsibly.</string>
    <string name="onboarding_terms_privacy_link">View full privacy details</string>
    <string name="onboarding_terms_privacy_dialog_title">How provider privacy works</string>
    <string name="onboarding_terms_privacy_dialog_body">FRIDAY stores provider configs in encrypted local storage on this phone.\n\nWhen you send a message, FRIDAY sends your prompt directly from Android to the provider you selected. FRIDAY servers do not proxy, inspect, or store those requests.\n\nYour provider may store or process requests under its own terms. Use a provider you trust.</string>
    <string name="onboarding_terms_privacy_dialog_got_it">Got it</string>
    <string name="onboarding_terms_agree_cta">I understand and agree</string>

    <!-- Onboarding Feature Tour (FRI-582 P4, design-spec §4, HTML TOUR array lines 1432-1443) -->
    <string name="onboarding_tour_title">Meet Friday</string>
    <string name="onboarding_tour_subtitle">A private AI companion built around your phone, your models, and your choices.</string>
    <string name="onboarding_tour_card1_title">Private by design</string>
    <string name="onboarding_tour_card1_body">Your conversations, transcripts, documents, memories, and gateway keys stay on this device by default.</string>
    <string name="onboarding_tour_card2_title">Chat or speak naturally</string>
    <string name="onboarding_tour_card2_body">Type a message, or hold the mic and speak. Friday can reply by text or voice when voice models are ready.</string>
    <string name="onboarding_tour_card3_title">Bring your own gateway</string>
    <string name="onboarding_tour_card3_body">Use Gemini, OpenAI, Anthropic, OpenClaw, Hermes, or a custom endpoint. FRIDAY connects directly from Android.</string>
    <string name="onboarding_tour_card4_title">Encrypted local history</string>
    <string name="onboarding_tour_card4_body">Your chat and voice history are stored locally in encrypted storage, not synced to FRIDAY servers.</string>
    <string name="onboarding_tour_card5_title">Grow when needed</string>
    <string name="onboarding_tour_card5_body">Add document search, local models, and advanced tools later. Start simple now.</string>
    <string name="onboarding_tour_continue_cta">Continue</string>
</resources>
