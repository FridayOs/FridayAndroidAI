    <string name="onboarding_terms_topbar_title">Điều khoản sử dụng</string>
    <string name="onboarding_terms_title">Trước khi bắt đầu</string>
    <string name="onboarding_terms_subtitle">Ngôn ngữ dễ hiểu. Không chiêu trò.</string>
    <string name="onboarding_terms_card1_title">Dữ liệu của bạn là của bạn</string>
    <string name="onboarding_terms_card1_body">Hội thoại, prompt, câu trả lời, bản ghi, tài liệu, ghi nhớ, cấu hình gateway, API key, base URL và lựa chọn model mặc định ở lại trên máy này.</string>
    <string name="onboarding_terms_card2_title">Đăng nhập dùng để làm gì</string>
    <string name="onboarding_terms_card2_body">Đăng nhập Google giúp FRIDAY nhận diện tài khoản, đăng ký thiết bị và áp dụng quyền/chính sách. Không tải lịch sử trò chuyện riêng tư của bạn lên.</string>
    <string name="onboarding_terms_card3_title">Gateway của bạn, cuộc gọi của bạn</string>
    <string name="onboarding_terms_card3_body">Khi bạn thêm provider như Gemini, OpenAI, Anthropic, OpenClaw, Hermes hoặc endpoint tùy chỉnh, FRIDAY gọi trực tiếp từ máy này. Điều khoản của provider áp dụng cho các yêu cầu đó.</string>
    <string name="onboarding_terms_card4_title">Friday có thể sai</string>
    <string name="onboarding_terms_card4_body">Hãy coi câu trả lời là trợ giúp, không phải chân lý. Kiểm chứng mọi nội dung y tế, pháp lý, tài chính hoặc an toàn.</string>
    <string name="onboarding_terms_card5_title">Bảo mật cục bộ quan trọng</string>
    <string name="onboarding_terms_card5_body">Nếu bật khóa ứng dụng và quên mật khẩu, dữ liệu mã hóa cục bộ có thể không khôi phục được.</string>
    <string name="onboarding_terms_card6_title">Thỏa thuận</string>
    <string name="onboarding_terms_card6_body">Khi tiếp tục, bạn đồng ý sử dụng FRIDAY AI một cách có trách nhiệm.</string>
    <string name="onboarding_terms_privacy_link">Xem chi tiết quyền riêng tư</string>
    <string name="onboarding_terms_privacy_dialog_title">Quyền riêng tư provider hoạt động ra sao</string>
    <string name="onboarding_terms_privacy_dialog_body">FRIDAY lưu cấu hình provider trong bộ nhớ mã hóa cục bộ trên máy này.\n\nKhi bạn gửi tin nhắn, FRIDAY gửi prompt trực tiếp từ Android tới provider bạn chọn. Máy chủ FRIDAY không proxy, không đọc, không lưu các yêu cầu đó.\n\nProvider của bạn có thể lưu hoặc xử lý yêu cầu theo điều khoản riêng của họ. Hãy dùng provider bạn tin tưởng.</string>
    <string name="onboarding_terms_privacy_dialog_got_it">Đã hiểu</string>
    <string name="onboarding_terms_agree_cta">Tôi hiểu và đồng ý</string>

    <!-- Onboarding Feature Tour (FRI-582 P4, design-spec §4, HTML TOUR array lines 1432-1443) -->
    <string name="onboarding_tour_title">Gặp Friday</string>
    <string name="onboarding_tour_subtitle">Trợ lý AI riêng tư, xoay quanh điện thoại, model và lựa chọn của bạn.</string>
    <string name="onboarding_tour_card1_title">Riêng tư từ thiết kế</string>
    <string name="onboarding_tour_card1_body">Hội thoại, bản ghi, tài liệu, ghi nhớ và key gateway mặc định ở lại trên thiết bị này.</string>
    <string name="onboarding_tour_card2_title">Chat hoặc nói tự nhiên</string>
    <string name="onboarding_tour_card2_body">Gõ tin nhắn, hoặc giữ mic và nói. Friday trả lời bằng chữ hoặc giọng nói khi model giọng nói sẵn sàng.</string>
    <string name="onboarding_tour_card3_title">Mang gateway của riêng bạn</string>
    <string name="onboarding_tour_card3_body">Dùng Gemini, OpenAI, Anthropic, OpenClaw, Hermes hoặc endpoint tùy chỉnh. FRIDAY kết nối trực tiếp từ Android.</string>
    <string name="onboarding_tour_card4_title">Lịch sử mã hóa cục bộ</string>
    <string name="onboarding_tour_card4_body">Lịch sử chat và giọng nói lưu cục bộ trong bộ nhớ mã hóa, không đồng bộ lên máy chủ FRIDAY.</string>
    <string name="onboarding_tour_card5_title">Mở rộng khi cần</string>
    <string name="onboarding_tour_card5_body">Thêm tìm kiếm tài liệu, model cục bộ và công cụ nâng cao sau. Giờ cứ bắt đầu đơn giản.</string>
    <string name="onboarding_tour_continue_cta">Tiếp tục</string>
